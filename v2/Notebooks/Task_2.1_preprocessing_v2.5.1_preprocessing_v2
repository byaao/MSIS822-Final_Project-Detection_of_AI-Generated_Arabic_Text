--------\n","# Normalization function applied consistently to text, stopwords, and lemmas\n","# ---------------------------------------------------------------------\n","def _norm_common(s: str) -> str:\n","    \"\"\"Normalize Arabic text by unifying forms and removing diacritics.\"\"\"\n","    if not isinstance(s, str):\n","        s = \"\" if s is None else str(s)\n","    s = normalize_unicode(s, compatibility=True)   # Unicode NFKC normalization\n","    s = dediac_ar(s)                               # Remove tashkeel\n","    s = normalize_alef_ar(s)                       # Unify hamza/alef forms\n","    s = normalize_alef_maksura_ar(s)               # ى → ي\n","    s = re.sub(r\"\\s+\", \" \", s).strip()\n","    return s\n","\n","# Normalize stopword list using the same rules\n","AR_STOPS = {w for w in (_norm_common(w) for w in AR_STOPS_RAW) if w}\n","\n","# ---------------------------------------------------------------------\n","# Lazy initialization of the CAMeL lemmatizer\n","# ---------------------------------------------------------------------\n","_MLE = None\n","def _mle():\n","    \"\"\"Load the CAMeL MLE disambiguator lazily (once).\"\"\"\n","    global _MLE\n","    if _MLE is None:\n","        _MLE = MLEDisambiguator.pretrained()  # MSA model\n","    return _MLE\n","\n","# ---------------------------------------------------------------------\n","# Main processing functions\n","# ---------------------------------------------------------------------\n","def normalize_arabic(s: str) -> str:\n","    \"\"\"\n","    Normalize Arabic text while keeping punctuation.\n","    Steps:\n","      - Unicode normalization (NFKC)\n","      - Remove diacritics (tashkeel)\n","      - Unify Alef variants and Alif Maqsura\n","      - Keep punctuation, digits, and spaces\n","    \"\"\"\n","    return _norm_common(s)\n","\n","def tokenize_arabic(s: str) -> list[str]:\n","    \"\"\"Tokenize Arabic text using CAMeL’s simple word tokenizer.\"\"\"\n","    return [t for t in simp